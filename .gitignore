# Build artifacts
target/
**/target/
node_modules/
**/node_modules/
dist/
**/dist/
.cache/
**/.cache/

# OS noise
.DS_Store
**/.DS_Store
_*
!**/_mockups/**
!_mockups/**

# Local artifacts not meant for the repo
_test.txt
_mockups/

# Blueprint workspace artifacts (regenerable, not source of truth).
# .agent/okf/ is the OKF bundle — portable into CodeRight and any OKF-aware agent — and IS tracked.
.agent/*
!.agent/okf/
.blueprint/

# IDE
.idea/
.vscode/
*.swp

# Environment
.env
.env.local
**/.env
**/.env.local

# local package-manager cache
.pnpm-store/

# PWA build output and installed deps (built on demand with npm + vite)
tools/roundtable/packages/web/dist/

# Credentials. The node falls back to ./node.token in its working directory when
# ROUNDTABLE_NODE_TOKEN_FILE is unset, so running it from a checkout drops a real
# credential here. Never let one be committed.
*.token
node.token
admin-token
